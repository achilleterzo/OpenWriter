node_modules/
dist/
.env
.env.*
!.env.example

# macOS Finder metadata file that should never be committed
.DS_Store
# Windows thumbnail cache file that should not be versioned
Thumbs.db
# Application and build log files generated during development
*.log
# npm debug logs produced on install or script errors
npm-debug.log*
# yarn debug logs in case yarn is ever used instead of npm
yarn-debug.log*
# yarn error logs in case yarn is ever used instead of npm
yarn-error.log*
# VS Code editor configuration directory with user-specific settings
.vscode/
# JetBrains IDE configuration directory with user-specific settings
.idea/
# Common Electron packaging output directory when using electron-builder or similar tools
release/
# Alternative Electron/Vite build output directory for packaged applications
out/
# TypeScript incremental build info file that may appear if TS is introduced
*.tsbuildinfo
# Test coverage output directory generated by testing tools
coverage/
