{
  "name": "openwriter",
  "version": "1.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "lint": "node --check electron/main.cjs && node --check electron/ai-providers.cjs && node --check electron/chat-store.cjs && node --check electron/notes-store.cjs && node --check electron/project-file.cjs && node --check electron/project-tools.cjs && node --check electron/images.cjs && node --check electron/menu.cjs && node --check electron/i18n.cjs && node --check electron/projects.cjs && node --check electron/project-owner.cjs && node --check electron/skills-store.cjs && node --check electron/preload.cjs",
    "test": "npm run build",
    "dist:desktop": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "build:desktop:ci": "npm run build && electron-builder"
  },
  "dependencies": {
    "html-to-docx": "^1.8.0",
    "mammoth": "^1.12.1",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@mozilla/readability": "^0.6.0",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-code": "^3.29.2",
    "@tiptap/extension-heading": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/markdown": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "^26.15.3",
    "lucide-react": "^1.31.0",
    "postcss": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "vite": "latest",
    "wait-on": "latest"
  },
  "build": {
    "appId": "local.openwriter.app",
    "productName": "OpenWriter",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "src/i18n/locales/*.json",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown"],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    },
    "icon": "assets/icon.png"
  }
}
